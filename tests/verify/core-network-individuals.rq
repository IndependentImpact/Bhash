PREFIX hedera: <https://hashgraphontology.xyz/core/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Violation query for the entailment harness (D-0005): the network named
# individuals must carry the identifiers that tie them to the canonical
# resource IRIs ({network} = skos:notation) and to external identifiers, and
# hedera:HBAR must be entailed to be a hedera:DigitalAsset with 8 decimals
# (D-0006).
SELECT ?violation
WHERE {
  {
    VALUES (?network ?notation ?ledgerId ?chainId) {
      (hedera:Mainnet    "mainnet"    "00" 295)
      (hedera:Testnet    "testnet"    "01" 296)
      (hedera:Previewnet "previewnet" "02" 297)
    }
    FILTER NOT EXISTS {
      ?network a hedera:Network ;
               skos:notation ?n ;
               hedera:hasLedgerId ?l ;
               hedera:hasEvmChainId ?c ;
               hedera:hasNativeCurrency hedera:HBAR .
      FILTER(STR(?n) = ?notation && STR(?l) = ?ledgerId && ?c = ?chainId)
    }
    BIND(CONCAT(STR(?network), " is missing its type, notation, ledger ID, chain ID or native currency") AS ?violation)
  }
  UNION
  {
    FILTER NOT EXISTS { hedera:HBAR a hedera:DigitalAsset }
    BIND("hedera:HBAR is not entailed to be a hedera:DigitalAsset" AS ?violation)
  }
  UNION
  {
    FILTER NOT EXISTS { hedera:HBAR hedera:hasDecimals 8 }
    BIND("hedera:HBAR does not declare hedera:hasDecimals 8" AS ?violation)
  }
}
