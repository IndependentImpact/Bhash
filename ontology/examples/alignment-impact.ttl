@prefix ex: <https://hashgraphontology.xyz/examples/impact/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix aiao: <http://w3id.org/aiao#> .
@prefix claimont: <https://datadudes.xyz/claimont#> .
@prefix impactont: <http://w3id.org/impactont#> .
@prefix infocomm: <https://datadudes.xyz/ontology/infocomm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:CommunityTreasury
    a hedera:Account, impactont:Thing ;
    rdfs:label "Community Reforestation Treasury"@en ;
    .

ex:CarbonCreditToken
    a hedera:FungibleToken, impactont:Thing ;
    rdfs:label "Carbon Credit Token"@en ;
    hedera:hasTreasury ex:CommunityTreasury ;
    .

# SDG Goals - domain-specific instances
ex:SDG15LifeOnLand
    a hedera:SDGGoal ;
    rdfs:label "SDG 15 Life on Land"@en ;
    .

ex:ForestResiliencePolicy
    a hedera:PolicyInstrument ;
    rdfs:label "Forest Resilience Policy"@en ;
    .

ex:SDG13ClimateAction
    a hedera:SDGGoal ;
    rdfs:label "SDG 13 Climate Action"@en ;
    .

ex:CarbonResiliencePolicy
    a hedera:PolicyInstrument ;
    rdfs:label "Carbon Resilience Policy"@en ;
    .

infocomm:SLA-EcoTelemetry
    a infocomm:ServiceLevelAgreement ;
    rdfs:label "Eco Telemetry SLA"@en ;
    .

ex:ReforestationImpactStatement
    a claimont:ImpactStatement ;
    rdfs:label "Q4 Reforestation Impact Statement"@en ;
    .

ex:HieroUpgradeQ4
    a hedera:ResilienceMilestone ;
    rdfs:label "Hiero Q4 Sustainability Upgrade"@en ;
    .

ex:HieroSegmentA
    a hedera:HieroCommunicationSegment ;
    rdfs:label "Hiero Segment A"@en ;
    hedera:hasShardIdentifier "SEG-A" ;
    .

ex:MirrorNodeAlpha
    a hedera:MirrorCommunicationNode ;
    rdfs:label "Mirror Node Alpha"@en ;
    hedera:anchorsTelemetryPolicy infocomm:SLA-EcoTelemetry ;
    hedera:hasTelemetryLatency "2.5"^^xsd:decimal ;
    .

ex:MirrorNodeBeta
    a hedera:MirrorCommunicationNode ;
    rdfs:label "Mirror Node Beta"@en ;
    hedera:anchorsTelemetryPolicy infocomm:SLA-EcoTelemetry ;
    hedera:hasTelemetryLatency "3.1"^^xsd:decimal ;
    .

ex:ReforestationDataset
    a hedera:MirrorDataset ;
    rdfs:label "Reforestation Balance Dataset"@en ;
    hedera:hasDatasetType "impact-balances" ;
    hedera:hasDatasetURI "https://mirror.hedera.example/datasets/reforestation"^^xsd:anyURI ;
    hedera:coversService hedera:TokenService ;
    hedera:hasRetentionPolicy ex:ReforestationRetentionPolicy ;
    .

ex:ReforestationRetentionPolicy
    a hedera:DatasetRetentionPolicy ;
    rdfs:label "Reforestation Dataset Retention"@en ;
    hedera:hasRetentionDays "30"^^xsd:integer ;
    .

ex:SoilCarbonDataset
    a hedera:MirrorDataset ;
    rdfs:label "Soil Carbon Dataset"@en ;
    hedera:hasDatasetType "impact-carbon" ;
    hedera:hasDatasetURI "https://mirror.hedera.example/datasets/soil-carbon"^^xsd:anyURI ;
    hedera:coversService hedera:TokenService ;
    hedera:hasRetentionPolicy ex:SoilCarbonRetentionPolicy ;
    .

ex:SoilCarbonRetentionPolicy
    a hedera:DatasetRetentionPolicy ;
    rdfs:label "Soil Carbon Retention"@en ;
    hedera:hasRetentionDays "45"^^xsd:integer ;
    .

# Indicators for measuring sustainability states
ex:TreasuryBalanceIndicator
    a hedera:TreasuryBalanceIndicator, impactont:Indicator ;
    rdfs:label "Treasury Balance Indicator"@en ;
    skos:definition "Measures the token balance in a treasury account."@en ;
    .

# States of the treasury at specific points in time
ex:ReforestationState
    a impactont:State ;
    rdfs:label "Reforestation Treasury State Q4 2024"@en ;
    impactont:isStateOf ex:CommunityTreasury ;
    impactont:isDefinedByIndicator ex:TreasuryBalanceIndicator ;
    impactont:hasIndicatorValue "1250"^^xsd:decimal ;
    impactont:hasModality "real" ;
    hedera:relatedToSDGGoal ex:SDG15LifeOnLand ;
    hedera:relatedToPolicy ex:ForestResiliencePolicy ;
    .

ex:ReforestationBaselineState
    a impactont:State ;
    rdfs:label "Reforestation Treasury Baseline State"@en ;
    impactont:isStateOf ex:CommunityTreasury ;
    impactont:isDefinedByIndicator ex:TreasuryBalanceIndicator ;
    impactont:hasIndicatorValue "1000"^^xsd:decimal ;
    impactont:hasModality "real" ;
    .

ex:SoilCarbonState
    a impactont:State ;
    rdfs:label "Soil Carbon Treasury State Q3 2024"@en ;
    impactont:isStateOf ex:CommunityTreasury ;
    impactont:isDefinedByIndicator ex:TreasuryBalanceIndicator ;
    impactont:hasIndicatorValue "980"^^xsd:decimal ;
    impactont:hasModality "real" ;
    hedera:relatedToSDGGoal ex:SDG13ClimateAction ;
    hedera:relatedToPolicy ex:CarbonResiliencePolicy ;
    .

ex:SoilCarbonBaselineState
    a impactont:State ;
    rdfs:label "Soil Carbon Baseline State"@en ;
    impactont:isStateOf ex:CommunityTreasury ;
    impactont:isDefinedByIndicator ex:TreasuryBalanceIndicator ;
    impactont:hasIndicatorValue "900"^^xsd:decimal ;
    impactont:hasModality "real" ;
    .

ex:ReforestationSchedule
    a hedera:ScheduledMitigationAction, impactont:Impact ;
    rdfs:label "Scheduled Funding for Reforestation"@en ;
    hedera:hasClimateWindow "2024-Q4" ;
    hedera:linkedImpactAssertion ex:ReforestationImpactStatement ;
    hedera:tracksResilienceMilestone ex:HieroUpgradeQ4 ;
    hedera:advancesClimateObjective claimont:ForestRestorationObjective ;
    impactont:impacts ex:ReforestationState ;
    impactont:hasStateA ex:ReforestationBaselineState ;
    impactont:hasStateB ex:ReforestationState ;
    .

ex:ReforestationSchedule a claimont:MitigationAction .

claimont:ForestRestorationObjective
    a claimont:ClimateObjective ;
    rdfs:label "Forest Restoration Objective"@en ;
    .

ex:SoilCarbonSchedule
    a hedera:ScheduledMitigationAction, impactont:Impact ;
    rdfs:label "Soil Carbon Sampling"@en ;
    hedera:hasClimateWindow "2024-Q3" ;
    hedera:linkedImpactAssertion ex:SoilCarbonImpactStatement ;
    hedera:tracksResilienceMilestone ex:HieroUpgradeQ4 ;
    hedera:advancesClimateObjective claimont:CarbonSequestrationObjective ;
    impactont:impacts ex:SoilCarbonState ;
    impactont:hasStateA ex:SoilCarbonBaselineState ;
    impactont:hasStateB ex:SoilCarbonState ;
    .

ex:SoilCarbonSchedule a claimont:MitigationAction .

claimont:CarbonSequestrationObjective
    a claimont:ClimateObjective ;
    rdfs:label "Carbon Sequestration Objective"@en ;
    .

ex:SoilCarbonImpactStatement
    a claimont:ImpactStatement ;
    rdfs:label "Q3 Soil Carbon Impact Statement"@en ;
    .

ex:TelemetryExchangeQ4
    a hedera:ImpactTelemetryExchange ;
    rdfs:label "Q4 Telemetry Exchange"@en ;
    hedera:routesThroughSegment ex:HieroSegmentA ;
    hedera:servedByNode ex:MirrorNodeAlpha ;
    .

ex:TelemetryExchangeQ3
    a hedera:ImpactTelemetryExchange ;
    rdfs:label "Q3 Telemetry Exchange"@en ;
    hedera:routesThroughSegment ex:HieroSegmentA ;
    hedera:servedByNode ex:MirrorNodeBeta ;
    .

ex:ReforestationAssertion
    a hedera:StablecoinReserveAssertion, aiao:ImpactClaim ;
    rdfs:label "Reforestation Impact Claim"@en ;
    hedera:hasImpactSubject ex:CommunityTreasury ;
    hedera:reportsImpactState ex:ReforestationState ;
    hedera:deliveredBySchedule ex:ReforestationSchedule ;
    hedera:referencesMirrorDataset ex:ReforestationDataset ;
    hedera:capturesImpactWindow "2024-Q4" ;
    .

ex:SoilCarbonAssertion
    a hedera:ConsensusImpactAssertion, aiao:ImpactClaim ;
    rdfs:label "Soil Carbon Impact Claim"@en ;
    hedera:hasImpactSubject ex:CommunityTreasury ;
    hedera:reportsImpactState ex:SoilCarbonState ;
    hedera:deliveredBySchedule ex:SoilCarbonSchedule ;
    hedera:referencesMirrorDataset ex:SoilCarbonDataset ;
    hedera:capturesImpactWindow "2024-Q3" ;
    .

ex:MirrorNodeAlpha hedera:publishesImpactDataset ex:ReforestationDataset .

ex:MirrorNodeAlpha a infocomm:CommunicationNode .

ex:MirrorNodeBeta hedera:publishesImpactDataset ex:SoilCarbonDataset .

ex:MirrorNodeBeta a infocomm:CommunicationNode .
