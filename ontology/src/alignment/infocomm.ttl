@prefix : <https://hashgraphontology.xyz/alignment/infocomm/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix infocomm: <http://w3id.org/infocomm#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://hashgraphontology.xyz/alignment/infocomm>
    a owl:Ontology ;
    dcterms:title "InfoComm alignment module"@en ;
    dcterms:description "Maps Hedera/Hiero network elements to the Information Communication Ontology, modelling HCS message submission as communication events, mirror nodes as communication parties, and HAPI as the governing protocol."@en ;
    dcterms:creator "Bhash Ontology Working Group"@en ;
    dcterms:created "2025-10-01"^^xsd:date ;
    dcterms:modified "2025-10-15"^^xsd:date ;
    owl:imports <https://hashgraphontology.xyz/core> ,
        <https://hashgraphontology.xyz/mirror-analytics> ,
        <https://hashgraphontology.xyz/consensus> ;
    owl:versionInfo "0.1.0-dev" ;
    dcterms:source <http://w3id.org/infocomm> ;
    rdfs:seeAlso <https://github.com/aiaont/infocomm> ;
    skos:editorialNote "Phase 4 bridge module exposing HCS message submission as InfoComm CommunicationEvents, mirror nodes as CommunicationParties, and the Hedera API as an InfoComm Protocol."@en ;
    .

###
# Alignment classes
###

hedera:HCSCommunicationEvent
    a owl:Class ;
    rdfs:label "HCS communication event"@en ;
    rdfs:subClassOf hedera:Event ,
        infocomm:CommunicationEvent ;
    skos:definition "The transport of a Hedera Consensus Service message through the network, treated as an information communication event."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows> ;
    dcterms:source <http://w3id.org/infocomm#CommunicationEvent> ;
    .

hedera:MirrorCommunicationParty
    a owl:Class ;
    rdfs:label "Mirror communication party"@en ;
    rdfs:subClassOf hedera:MirrorService ,
        infocomm:CommunicationParty ;
    skos:definition "A Hedera mirror service acting as a receiving communication party for consensus data."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/mirror-node> ;
    dcterms:source <http://w3id.org/infocomm#CommunicationParty> ;
    .

hedera:HAPIProtocol
    a owl:Class ;
    rdfs:label "HAPI protocol"@en ;
    rdfs:subClassOf infocomm:Protocol ;
    skos:definition "The Hedera API (HAPI) protocol that governs the rules of transaction submission and query communication on the Hedera network."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/sdks-and-apis/hedera-api> ;
    dcterms:source <http://w3id.org/infocomm#Protocol> ;
    .

###
# Alignment properties
###

hedera:transmitsTopicMessage
    a owl:ObjectProperty ;
    rdfs:label "transmits topic message"@en ;
    rdfs:domain hedera:HCSCommunicationEvent ;
    rdfs:range hedera:TopicMessage ;
    rdfs:subPropertyOf infocomm:transmits ;
    skos:definition "Identifies the topic message transmitted during an HCS communication event."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows> ;
    dcterms:source <http://w3id.org/infocomm#transmits> ;
    .

hedera:hasMirrorRecipient
    a owl:ObjectProperty ;
    rdfs:label "has mirror recipient"@en ;
    rdfs:domain hedera:HCSCommunicationEvent ;
    rdfs:range hedera:MirrorCommunicationParty ;
    rdfs:subPropertyOf infocomm:hasRecipient ;
    skos:definition "Identifies the mirror service that receives consensus data during an HCS communication event."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/mirror-node/sdks-and-apis/rest-api> ;
    dcterms:source <http://w3id.org/infocomm#hasRecipient> ;
    .

hedera:hasConsensusNodeSender
    a owl:ObjectProperty ;
    rdfs:label "has consensus node sender"@en ;
    rdfs:domain hedera:HCSCommunicationEvent ;
    rdfs:range infocomm:CommunicationParty ;
    rdfs:subPropertyOf infocomm:hasSender ;
    skos:definition "Identifies the consensus node acting as sender in an HCS communication event."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows> ;
    dcterms:source <http://w3id.org/infocomm#hasSender> ;
    .

hedera:hasCommunicationFormat
    a owl:ObjectProperty ;
    rdfs:label "has communication format"@en ;
    rdfs:domain hedera:HCSCommunicationEvent ;
    rdfs:range infocomm:Format ;
    rdfs:subPropertyOf infocomm:hasFormat ;
    skos:definition "Specifies the encoding format (e.g., protobuf, JSON) used during an HCS communication event."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/sdks-and-apis/hedera-api> ;
    dcterms:source <http://w3id.org/infocomm#hasFormat> ;
    .
