@prefix : <https://hashgraphontology.xyz/alignment/claimont/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix claimont: <http://w3id.org/claimont#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://hashgraphontology.xyz/alignment/claimont>
    a owl:Ontology ;
    dcterms:title "ClaimOnt alignment module"@en ;
    dcterms:description "Aligns Hedera governance decisions, scheduled transactions, and consensus records with the Claim Ontology, mapping on-chain artefacts to claims and their substantiation."@en ;
    dcterms:creator "Bhash Ontology Working Group"@en ;
    dcterms:created "2025-10-01"^^xsd:date ;
    dcterms:modified "2025-10-15"^^xsd:date ;
    owl:imports <https://hashgraphontology.xyz/core> ,
        <https://hashgraphontology.xyz/file-schedule> ,
        <https://hashgraphontology.xyz/consensus> ;
    owl:versionInfo "0.1.0-dev" ;
    dcterms:source <http://w3id.org/claimont> ;
    rdfs:seeAlso <https://github.com/aiaont/claimont> ;
    skos:editorialNote "Phase 4 bridge module aligning Hedera on-chain artefacts with the Claim Ontology core model: Claims are made by Claimants, substantiated by Substantiations, and may comprise sub-claims."@en ;
    .

###
# Alignment classes
###

hedera:HederaSubstantiation
    a owl:Class ;
    rdfs:label "Hedera substantiation"@en ;
    rdfs:subClassOf hedera:TopicMessage ,
        claimont:Substantiation ;
    skos:definition "A Hedera Consensus Service message that provides immutable on-chain evidence as substantiation for a claim."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows> ;
    dcterms:source <http://w3id.org/claimont#Substantiation> ;
    .

hedera:ScheduledReport
    a owl:Class ;
    rdfs:label "Scheduled report"@en ;
    rdfs:subClassOf hedera:ScheduledTransaction ,
        claimont:Report ;
    skos:definition "A scheduled transaction whose execution produces a structured on-chain report within the meaning of the Claim Ontology."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/scheduled-transactions/introduction> ;
    dcterms:source <http://w3id.org/claimont#Report> ;
    .

hedera:GovernanceClaim
    a owl:Class ;
    rdfs:label "Governance claim"@en ;
    rdfs:subClassOf hedera:GovernanceDecision ,
        claimont:Claim ;
    skos:definition "A governance decision recorded on-chain as a formal claim within the meaning of the Claim Ontology."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/governing-the-network> ;
    dcterms:source <http://w3id.org/claimont#Claim> ;
    .

###
# Alignment properties
###

hedera:substantiatedByRecord
    a owl:ObjectProperty ;
    rdfs:label "substantiated by record"@en ;
    rdfs:domain claimont:Claim ;
    rdfs:range hedera:HederaSubstantiation ;
    rdfs:subPropertyOf claimont:isSupportedBy ;
    skos:definition "Associates a claim with the immutable Hedera Consensus Service record that substantiates it."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows> ;
    dcterms:source <http://w3id.org/claimont#isSupportedBy> ;
    .

hedera:hasClaimSubject
    a owl:ObjectProperty ;
    rdfs:label "has claim subject"@en ;
    rdfs:domain claimont:Claim ;
    rdfs:range hedera:Account ;
    rdfs:subPropertyOf claimont:hasSubject ;
    skos:definition "Identifies the Hedera account that is the subject of a claim."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/governing-the-network> ;
    dcterms:source <http://w3id.org/claimont#hasSubject> ;
    .

hedera:claimMadeByAccount
    a owl:ObjectProperty ;
    rdfs:label "claim made by account"@en ;
    rdfs:domain claimont:Claim ;
    rdfs:range hedera:Account ;
    rdfs:subPropertyOf claimont:isMadeBy ;
    skos:definition "Associates a claim with the Hedera account acting as the claimant."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/governing-the-network> ;
    dcterms:source <http://w3id.org/claimont#isMadeBy> ;
    .

hedera:comprisesClaimRecord
    a owl:ObjectProperty ;
    rdfs:label "comprises claim record"@en ;
    rdfs:domain claimont:Claim ;
    rdfs:range claimont:Claim ;
    rdfs:subPropertyOf claimont:comprisesClaims ;
    skos:definition "A composite on-chain claim comprises individual sub-claims recorded on the Hedera network."@en ;
    hedera:sourceDocument <https://docs.hedera.com/hedera/core-concepts/governing-the-network> ;
    dcterms:source <http://w3id.org/claimont#comprisesClaims> ;
    .
