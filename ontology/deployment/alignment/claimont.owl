<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:hedera="https://hashgraphontology.xyz/core/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/comprisesClaimRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">comprises claim record</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/claimont#Claim"/>
    <rdfs:range rdf:resource="http://w3id.org/claimont#Claim"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/claimont#comprisesClaims"/>
    <skos:definition xml:lang="en">A composite on-chain claim comprises individual sub-claims recorded on the Hedera network.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/governing-the-network"/>
    <dcterms:source rdf:resource="http://w3id.org/claimont#comprisesClaims"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/hasClaimSubject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has claim subject</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/claimont#Claim"/>
    <rdfs:range rdf:resource="https://hashgraphontology.xyz/core/Account"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/claimont#hasSubject"/>
    <skos:definition xml:lang="en">Identifies the Hedera account that is the subject of a claim.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/governing-the-network"/>
    <dcterms:source rdf:resource="http://w3id.org/claimont#hasSubject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/HederaSubstantiation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hedera substantiation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://hashgraphontology.xyz/core/TopicMessage"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/claimont#Substantiation"/>
    <skos:definition xml:lang="en">A Hedera Consensus Service message that provides immutable on-chain evidence as substantiation for a claim.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows"/>
    <dcterms:source rdf:resource="http://w3id.org/claimont#Substantiation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/alignment/claimont">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">ClaimOnt alignment module</dcterms:title>
    <dcterms:description xml:lang="en">Aligns Hedera governance decisions, scheduled transactions, and consensus records with the Claim Ontology, mapping on-chain artefacts to claims and their substantiation.</dcterms:description>
    <dcterms:creator xml:lang="en">Bhash Ontology Working Group</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-15</dcterms:modified>
    <owl:imports rdf:resource="https://hashgraphontology.xyz/core"/>
    <owl:imports rdf:resource="https://hashgraphontology.xyz/file-schedule"/>
    <owl:imports rdf:resource="https://hashgraphontology.xyz/consensus"/>
    <owl:versionInfo>0.1.0-dev</owl:versionInfo>
    <dcterms:source rdf:resource="http://w3id.org/claimont"/>
    <rdfs:seeAlso rdf:resource="https://github.com/aiaont/claimont"/>
    <skos:editorialNote xml:lang="en">Phase 4 bridge module aligning Hedera on-chain artefacts with the Claim Ontology core model: Claims are made by Claimants, substantiated by Substantiations, and may comprise sub-claims.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/claimMadeByAccount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">claim made by account</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/claimont#Claim"/>
    <rdfs:range rdf:resource="https://hashgraphontology.xyz/core/Account"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/claimont#isMadeBy"/>
    <skos:definition xml:lang="en">Associates a claim with the Hedera account acting as the claimant.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/governing-the-network"/>
    <dcterms:source rdf:resource="http://w3id.org/claimont#isMadeBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/substantiatedByRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">substantiated by record</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/claimont#Claim"/>
    <rdfs:range rdf:resource="https://hashgraphontology.xyz/core/HederaSubstantiation"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/claimont#isSupportedBy"/>
    <skos:definition xml:lang="en">Associates a claim with the immutable Hedera Consensus Service record that substantiates it.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows"/>
    <dcterms:source rdf:resource="http://w3id.org/claimont#isSupportedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/ScheduledReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Scheduled report</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://hashgraphontology.xyz/core/ScheduledTransaction"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/claimont#Report"/>
    <skos:definition xml:lang="en">A scheduled transaction whose execution produces a structured on-chain report within the meaning of the Claim Ontology.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/scheduled-transactions/introduction"/>
    <dcterms:source rdf:resource="http://w3id.org/claimont#Report"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/GovernanceClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Governance claim</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://hashgraphontology.xyz/core/GovernanceDecision"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/claimont#Claim"/>
    <skos:definition xml:lang="en">A governance decision recorded on-chain as a formal claim within the meaning of the Claim Ontology.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/governing-the-network"/>
    <dcterms:source rdf:resource="http://w3id.org/claimont#Claim"/>
  </rdf:Description>
</rdf:RDF>
