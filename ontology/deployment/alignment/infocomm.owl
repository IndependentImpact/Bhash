<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:hedera="https://hashgraphontology.xyz/core/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/transmitsTopicMessage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">transmits topic message</rdfs:label>
    <rdfs:domain rdf:resource="https://hashgraphontology.xyz/core/HCSCommunicationEvent"/>
    <rdfs:range rdf:resource="https://hashgraphontology.xyz/core/TopicMessage"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/infocomm#transmits"/>
    <skos:definition xml:lang="en">Identifies the topic message transmitted during an HCS communication event.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows"/>
    <dcterms:source rdf:resource="http://w3id.org/infocomm#transmits"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/hasCommunicationFormat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has communication format</rdfs:label>
    <rdfs:domain rdf:resource="https://hashgraphontology.xyz/core/HCSCommunicationEvent"/>
    <rdfs:range rdf:resource="http://w3id.org/infocomm#Format"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/infocomm#hasFormat"/>
    <skos:definition xml:lang="en">Specifies the encoding format (e.g., protobuf, JSON) used during an HCS communication event.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/sdks-and-apis/hedera-api"/>
    <dcterms:source rdf:resource="http://w3id.org/infocomm#hasFormat"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/MirrorCommunicationParty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mirror communication party</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://hashgraphontology.xyz/core/MirrorService"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/infocomm#CommunicationParty"/>
    <skos:definition xml:lang="en">A Hedera mirror service acting as a receiving communication party for consensus data.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/mirror-node"/>
    <dcterms:source rdf:resource="http://w3id.org/infocomm#CommunicationParty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/alignment/infocomm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">InfoComm alignment module</dcterms:title>
    <dcterms:description xml:lang="en">Maps Hedera/Hiero network elements to the Information Communication Ontology, modelling HCS message submission as communication events, mirror nodes as communication parties, and HAPI as the governing protocol.</dcterms:description>
    <dcterms:creator xml:lang="en">Bhash Ontology Working Group</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-15</dcterms:modified>
    <owl:imports rdf:resource="https://hashgraphontology.xyz/core"/>
    <owl:imports rdf:resource="https://hashgraphontology.xyz/mirror-analytics"/>
    <owl:imports rdf:resource="https://hashgraphontology.xyz/consensus"/>
    <owl:versionInfo>0.1.0-dev</owl:versionInfo>
    <dcterms:source rdf:resource="http://w3id.org/infocomm"/>
    <rdfs:seeAlso rdf:resource="https://github.com/aiaont/infocomm"/>
    <skos:editorialNote xml:lang="en">Phase 4 bridge module exposing HCS message submission as InfoComm CommunicationEvents, mirror nodes as CommunicationParties, and the Hedera API as an InfoComm Protocol.</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/hasConsensusNodeSender">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has consensus node sender</rdfs:label>
    <rdfs:domain rdf:resource="https://hashgraphontology.xyz/core/HCSCommunicationEvent"/>
    <rdfs:range rdf:resource="http://w3id.org/infocomm#CommunicationParty"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/infocomm#hasSender"/>
    <skos:definition xml:lang="en">Identifies the consensus node acting as sender in an HCS communication event.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows"/>
    <dcterms:source rdf:resource="http://w3id.org/infocomm#hasSender"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/HCSCommunicationEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">HCS communication event</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://hashgraphontology.xyz/core/Event"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/infocomm#CommunicationEvent"/>
    <skos:definition xml:lang="en">The transport of a Hedera Consensus Service message through the network, treated as an information communication event.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/core-concepts/hedera-consensus-service/message-flows"/>
    <dcterms:source rdf:resource="http://w3id.org/infocomm#CommunicationEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/hasMirrorRecipient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has mirror recipient</rdfs:label>
    <rdfs:domain rdf:resource="https://hashgraphontology.xyz/core/HCSCommunicationEvent"/>
    <rdfs:range rdf:resource="https://hashgraphontology.xyz/core/MirrorCommunicationParty"/>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/infocomm#hasRecipient"/>
    <skos:definition xml:lang="en">Identifies the mirror service that receives consensus data during an HCS communication event.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/mirror-node/sdks-and-apis/rest-api"/>
    <dcterms:source rdf:resource="http://w3id.org/infocomm#hasRecipient"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://hashgraphontology.xyz/core/HAPIProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">HAPI protocol</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://w3id.org/infocomm#Protocol"/>
    <skos:definition xml:lang="en">The Hedera API (HAPI) protocol that governs the rules of transaction submission and query communication on the Hedera network.</skos:definition>
    <hedera:sourceDocument rdf:resource="https://docs.hedera.com/hedera/sdks-and-apis/hedera-api"/>
    <dcterms:source rdf:resource="http://w3id.org/infocomm#Protocol"/>
  </rdf:Description>
</rdf:RDF>
