    "https://hashgraphontology.xyz/core/sourceDocument": [
      {
        "@id": "https://docs.hedera.com/hedera/mirror-node/sdks-and-apis/rest-api"
      }
    ]
  },
  {
    "@id": "https://hashgraphontology.xyz/core/hasCommunicationFormat",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
