  },
  {
    "@id": "https://hashgraphontology.xyz/alignment/infocomm",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-10-01"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@language": "en",
        "@value": "Bhash Ontology Working Group"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Maps Hedera/Hiero network elements to the Information Communication Ontology, modelling HCS message submission as communication events, mirror nodes as communication parties, and HAPI as the governing protocol."
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-10-15"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "http://w3id.org/infocomm"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "InfoComm alignment module"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://github.com/aiaont/infocomm"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://hashgraphontology.xyz/core"
      },
      {
        "@id": "https://hashgraphontology.xyz/mirror-analytics"
      },
      {
        "@id": "https://hashgraphontology.xyz/consensus"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.1.0-dev"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "en",
        "@value": "Phase 4 bridge module exposing HCS message submission as InfoComm CommunicationEvents, mirror nodes as CommunicationParties, and the Hedera API as an InfoComm Protocol."
      }
    ]
  },
  {
    "@id": "https://hashgraphontology.xyz/core/HAPIProtocol",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "http://w3id.org/infocomm#Protocol"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "HAPI protocol"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://w3id.org/infocomm#Protocol"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The Hedera API (HAPI) protocol that governs the rules of transaction submission and query communication on the Hedera network."
      }
    ],
    "https://hashgraphontology.xyz/core/sourceDocument": [
      {
        "@id": "https://docs.hedera.com/hedera/sdks-and-apis/hedera-api"
      }
    ]
  },
  {
