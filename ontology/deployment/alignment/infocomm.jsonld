      {
        "@id": "https://hashgraphontology.xyz/core/Event"
      },
      {
        "@id": "http://w3id.org/infocomm#CommunicationEvent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
