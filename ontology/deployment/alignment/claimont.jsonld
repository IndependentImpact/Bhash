      {
        "@id": "http://w3id.org/claimont#Claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://w3id.org/claimont#comprisesClaims"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A composite on-chain claim comprises individual sub-claims recorded on the Hedera network."
      }
    ],
    "https://hashgraphontology.xyz/core/sourceDocument": [
      {
        "@id": "https://docs.hedera.com/hedera/core-concepts/governing-the-network"
      }
    ]
  },
  {
    "@id": "https://hashgraphontology.xyz/core/HederaSubstantiation",
