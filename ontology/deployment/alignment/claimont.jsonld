        "@id": "https://hashgraphontology.xyz/core/Account"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://w3id.org/claimont#hasSubject"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifies the Hedera account that is the subject of a claim."
      }
    ],
    "https://hashgraphontology.xyz/core/sourceDocument": [
      {
        "@id": "https://docs.hedera.com/hedera/core-concepts/governing-the-network"
      }
    ]
  },
  {
    "@id": "https://hashgraphontology.xyz/core/GovernanceClaim",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
