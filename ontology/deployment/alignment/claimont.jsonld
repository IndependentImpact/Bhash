  },
  {
    "@id": "https://hashgraphontology.xyz/core/ScheduledReport",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "http://w3id.org/claimont#Report"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Scheduled report"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://hashgraphontology.xyz/core/ScheduledTransaction"
      },
      {
        "@id": "http://w3id.org/claimont#Report"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A scheduled transaction whose execution produces a structured on-chain report within the meaning of the Claim Ontology."
      }
    ],
    "https://hashgraphontology.xyz/core/sourceDocument": [
      {
        "@id": "https://docs.hedera.com/hedera/core-concepts/scheduled-transactions/introduction"
      }
    ]
  },
  {
    "@id": "https://hashgraphontology.xyz/alignment/claimont",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-10-01"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@language": "en",
        "@value": "Bhash Ontology Working Group"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Aligns Hedera governance decisions, scheduled transactions, and consensus records with the Claim Ontology, mapping on-chain artefacts to claims and their substantiation."
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-10-15"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "http://w3id.org/claimont"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "ClaimOnt alignment module"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://github.com/aiaont/claimont"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://hashgraphontology.xyz/core"
      },
      {
        "@id": "https://hashgraphontology.xyz/file-schedule"
      },
      {
        "@id": "https://hashgraphontology.xyz/consensus"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.1.0-dev"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#editorialNote": [
      {
        "@language": "en",
        "@value": "Phase 4 bridge module aligning Hedera on-chain artefacts with the Claim Ontology core model: Claims are made by Claimants, substantiated by Substantiations, and may comprise sub-claims."
      }
    ]
  },
  {
    "@id": "https://hashgraphontology.xyz/core/hasClaimSubject",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
