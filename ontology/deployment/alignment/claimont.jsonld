      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A governance decision recorded on-chain as a formal claim within the meaning of the Claim Ontology."
      }
    ],
    "https://hashgraphontology.xyz/core/sourceDocument": [
      {
        "@id": "https://docs.hedera.com/hedera/core-concepts/governing-the-network"
      }
    ]
  },
